/* -------------------------------------------------------
   DROP ALL TABLES TO RESET SCHEMA CLEANLY
------------------------------------------------------- */
$conn->query("DROP TABLE IF EXISTS sales");
$conn->query("DROP TABLE IF EXISTS product_type");
$conn->query("DROP TABLE IF EXISTS products");
$conn->query("DROP TABLE IF EXISTS contacts");

/* -------------------------------------------------------
   Contacts Table
------------------------------------------------------- */
$createContactsSQL = "
CREATE TABLE contacts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    first_name VARCHAR(50),
    last_name VARCHAR(50),
    email VARCHAR(100)
)";
$conn->query($createContactsSQL);

/* CSV Import */
$csvFile = fopen("contacts.csv", "r");
$first = true;

while (($row = fgetcsv($csvFile)) !== FALSE) {
    if ($first) {
        $first = false;
        continue;
    }

    $first_name = $conn->real_escape_string($row[0]);
    $last_name  = $conn->real_escape_string($row[1]);
    $email      = $conn->real_escape_string($row[2]);

    $conn->query("
        INSERT INTO contacts (first_name, last_name, email)
        VALUES ('$first_name', '$last_name', '$email')
    ");
}
fclose($csvFile);

echo "Contacts imported.<br>";

