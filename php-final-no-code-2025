    <h2>Employees List</h2>
    <ul>
        <?php foreach ($employees as $emp): ?>
            <li>
                <?= htmlspecialchars($emp['last_name'] . ", " . $emp['first_name']) . ' - ' . htmlspecialchars($emp['email']); ?>
                <p>Job = <?= htmlspecialchars($emp['tech282_department']); ?></p>
                <a href="?delete=<?= $emp['tech282_names_id']; ?>" onclick="return confirm('Are you sure?')">Delete</a>
            </li>
        <?php endforeach; ?>
    </ul>
