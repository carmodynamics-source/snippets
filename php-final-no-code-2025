<?php
require 'db/db.php';
mysqli_report(MYSQLI_REPORT_ERROR | MYSQLI_REPORT_STRICT);

$first_name = "";
$last_name  = "";
$email      = "";
$department_id = "";
$errors = [];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $first_name = trim($_POST['first_name']);
    $last_name  = trim($_POST['last_name']);
    $email      = trim($_POST['email']);
    $department_id = $_POST['department'] ?? '';

    if (empty($first_name)) {
        $errors['first_name'] = "First name is required.";
    }
    if (empty($last_name)) {
        $errors['last_name'] = "Last name is required.";
    }
    if (empty($email)) {
        $errors['email'] = "Email is required.";
    } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $errors['email'] = "Invalid email format.";
    }
    if (empty($department_id)) {
        $errors['department'] = "Please select a department.";
    }

    if (empty($errors)) {
        $stmt = $conn->prepare(
            "INSERT INTO tech282_names (first_name, last_name, email)
             VALUES (?, ?, ?)"
        );
        $stmt->bind_param("sss", $first_name, $last_name, $email);
        $stmt->execute();
        $new_name_id = $conn->insert_id;

        $rel = $conn->prepare(
            "INSERT INTO tech282_relationships
             (relationships_id_names, relationships_id_department)
             VALUES (?, ?)"
        );
        $rel->bind_param("ii", $new_name_id, $department_id);
        $rel->execute();
        $rel->close();
        $stmt->close();

        header("Location: index.php");
        exit;
    }
}

if (isset($_GET['delete'])) {
    $delete_id = (int)$_GET['delete'];
    $stmt = $conn->prepare(
        "DELETE FROM tech282_names WHERE tech282_names_id=?"
    );
    $stmt->bind_param("i", $delete_id);
    $stmt->execute();
    $stmt->close();
    header("Location: index.php");
    exit;
}

$departments = [];
$result = $conn->query(
    "SELECT tech282_department_id, tech282_department
     FROM tech282_department
     ORDER BY tech282_department"
);
while ($row = $result->fetch_assoc()) {
    $departments[] = $row;
}
$result->free();

$employees = [];
$sql = "
    SELECT
        tech282_names.tech282_names_id,
        first_name,
        last_name,
        email,
        tech282_department.tech282_department
    FROM tech282_names
    INNER JOIN tech282_relationships
        ON tech282_names.tech282_names_id =
           tech282_relationships.relationships_id_names
    INNER JOIN tech282_department
        ON tech282_relationships.relationships_id_department =
           tech282_department.tech282_department_id
    ORDER BY last_name ASC
";
$result = $conn->query($sql);
while ($row = $result->fetch_assoc()) {
    $employees[] = $row;
}
$result->free();
?>
