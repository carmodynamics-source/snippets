            <?php if (isset($errors['first_name'])): ?>
                <span class="error"><?= $errors['first_name'] ?></span>
            <?php endif; ?>
        </label>
        <label>
            Last Name:
            <input type="text" name="last_name" value="<?= htmlspecialchars($last_name) ?>">
            <?php if (isset($errors['last_name'])): ?>
